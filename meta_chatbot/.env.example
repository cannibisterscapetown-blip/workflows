# ── Meta Credentials ──────────────────────────────────────────────────────────
# Page Access Token (from Meta Business Suite > Settings > Advanced > Page Access Token)
META_ACCESS_TOKEN=your_page_access_token_here

# App Secret (from Meta Developer App > Settings > Basic)
META_APP_SECRET=your_app_secret_here

# Custom string you choose — must match what you enter in Meta webhook settings
META_VERIFY_TOKEN=cannibisters_chatbot_verify

# ── Instagram ─────────────────────────────────────────────────────────────────
# Your Instagram Business Account ID (already known)
INSTAGRAM_ID=17841459113832751

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
