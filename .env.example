# Shopify API credentials
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token_here
SHOPIFY_STORE_URL=your-store.myshopify.com

# Shopify Webhook Seal Token
# Used to verify the HMAC-SHA256 signature on incoming Shopify webhooks.
# Found in: Shopify Admin > Settings > Notifications > Webhooks > signing secret
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret_here

# Meta / Facebook credentials (for Instagram and ad management)
META_ACCESS_TOKEN=your_meta_access_token_here
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_AD_ACCOUNT_ID=act_your_ad_account_id
META_INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
META_PAGE_ID=your_facebook_page_id
