  {
    "id": 8511890653396,
    "title": "Cannibisters Chemical Bride Rosin",
    "body_html": "<div>\n<span data-canva-clipboard=\"\"></span>\n<div>\n<p><span>Experience the powerful and complex effects of</span><span>\u00a0<strong>Chemical Bride Rosin</strong></span><span>. This </span><span><strong>hybrid</strong> strain</span><span>, created by blending </span><strong>Classic Chemdog</strong><span> genetics with </span><strong>Wedding Cake</strong><span>, delivers a unique combination of earthy, diesel notes with sweet, creamy undertones. The </span><span><strong>1-gram</strong> extract</span><span> offers a potent, smooth experience that\u2019s perfect for those seeking relaxation with a touch of euphoria.</span></p>\n</div>\n</div>\n<!---->",
    "vendor": "Cannibisters - The Herbal Apothecary",
