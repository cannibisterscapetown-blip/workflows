PORT=8787
# Mock mode when SHOPIFY_STOREFRONT_TOKEN is empty: fixtures from @cannibisters/shared are served.
SHOPIFY_STORE_DOMAIN=cannibisters.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-07
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2025-07
# BON Loyalty GraphQL (token from the BON dashboard)
BON_API_URL=https://graph.bonloyalty.com/graphql
BON_API_TOKEN=
# Existing loyalty + Cannisino backends
LOYALTY_API_BASE=https://cannibisters-loyalty.vercel.app
CANNISINO_EMBED_BASE=https://cannisino.vercel.app
# HMAC secret for member entry QR tokens (rotate to invalidate all codes)
ENTRY_TOKEN_SECRET=change-me
APP_SESSION_SECRET=change-me
# Night Owl window (Africa/Johannesburg), inclusive start, exclusive end
NIGHT_OWL_START_HOUR=0
NIGHT_OWL_END_HOUR=7
NIGHT_OWL_DISCOUNT_CODE=NIGHTOWL15
