    "cap:android": "cap add android"
  },
  "dependencies": {
    "@cannibisters/shared": "workspace:*",
    "@capacitor/core": "^7.4.3",
    "canvas-confetti": "^1.9.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.55.0",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
