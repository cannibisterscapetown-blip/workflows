{
  "name": "cannibisters-app",
  "private": true,
  "version": "0.1.0",
  "description": "Cannibisters members app: iOS, Android and web from one codebase.",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:mobile": "pnpm --filter @cannibisters/mobile dev",
    "dev:api": "pnpm --filter @cannibisters/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "shots": "pnpm --filter @cannibisters/mobile shots"
  }
}
